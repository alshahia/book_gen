{
  "$schema": "https://opencode.ai/config.json",
  "version": "0.1.0",
  "name": "book-kit",
  "description": "Portable book-writing environment. Master orchestrates the 7-phase book-gen pipeline via book-gen-orchestrator skill.",
  "agent": {
    "master": {
      "model": "default",
      "prompt_file": "agents_manager/master/SKILL.md",
      "tools": {
        "bash": { "permission": "allow" },
        "read": { "permission": "allow" },
        "write": { "permission": "allow" },
        "task": { "permission": "allow" },
        "webfetch": { "permission": "allow" },
        "grep": { "permission": "allow" },
        "glob": { "permission": "allow" }
      }
    },
    "am-research": {
      "model": "default",
      "prompt_file": "agents_manager/research/SKILL.md",
