# Auto-detect text vs binary; normalize line endings on commit.
* text=auto

# Force LF on cross-platform text assets.
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Force CRLF on Windows-native scripts.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries — leave alone.
*.zip binary